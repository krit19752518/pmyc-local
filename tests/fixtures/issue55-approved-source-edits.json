    "module": "routes/admin/adminPortal.router",
    "before": "  <!-- Admin Player Detail & Remarks Modal -->\n  ${athleteReviewStyles}\n  <div class=\"modal fade athlete-review-modal\" id=\"adminPlayerDetailModal\" tabindex=\"-1\" aria-labelledby=\"adminPlayerDetailModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable\">\n      <div class=\"modal-content rounded-4 border-0 shadow-lg\">\n        <div class=\"modal-header bg-navy text-white rounded-top-4\">\n          <h5 class=\"modal-header-title mb-0 fw-bold\" id=\"adminPlayerDetailModalLabel\"><i class=\"bi bi-person-lines-fill me-2\"></i>รายละเอียดข้อมูลนักกีฬา</h5>\n          <button type=\"button\" class=\"btn-close btn-close-white\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n        </div>\n        <div class=\"modal-body p-4 bg-light\">\n          <input type=\"hidden\" id=\"modalPlayerId\">\n          <div class=\"athlete-layout\">\n            <!-- Left Photo Column -->\n            <div class=\"athlete-photo-column\">\n              <div class=\"athlete-photo-panel\">\n                <img id=\"modalPlayerPhoto\" src=\"\" class=\"rounded-3 border shadow-sm\" alt=\"รูปถ่ายนักกีฬา\">\n              </div>\n\n            </div>\n\n            <!-- Right Details & Form Column -->\n            <div class=\"athlete-detail-column\">\n              ${renderAthleteInformation('modalPlayer')}\n\n              <!-- Uploaded Documents Checklist -->\n              <div class=\"card border-0 shadow-sm mb-3\">\n                <div class=\"card-body p-3\">\n                  <h6 class=\"fw-bold text-navy border-bottom pb-2 mb-2\"><i class=\"bi bi-file-earmark-pdf me-1\"></i> รายการเอกสารประกอบ</h6>\n                  <div class=\"d-flex flex-column gap-2 small\" id=\"modalPlayerDocsList\">\n                    <!-- Populated dynamically -->\n                  </div>\n                </div>\n              </div>\n\n              <!-- Admin Inspection & Remarks Form -->\n              <div class=\"card border-primary border-opacity-50 shadow-sm\">\n                <div class=\"card-body p-3 bg-white\">\n                  <h6 class=\"fw-bold text-primary border-bottom pb-2 mb-3\"><i class=\"bi bi-pencil-square me-1\"></i> ผลการตรวจสอบ & หมายเหตุเจ้าหน้าที่</h6>\n                  <div class=\"mb-3\">\n                    <label class=\"form-label small fw-bold text-navy\">สถานะการตรวจสอบเอกสาร</label>\n                    <select id=\"modalDocStatusSelect\" class=\"form-select form-select-sm\">\n                      <option value=\"PENDING\">⏳ รอตรวจสอบ (Pending)</option>\n                      <option value=\"APPROVED\">🟢 ครบถ้วน สมบูรณ์ / อนุมัติ (Approved)</option>\n                      <option value=\"ACTION_REQUIRED\">🟡 มีหมายเหตุ / ต้องแก้ไข (Action Required)</option>\n                      <option value=\"CORRECTED\">📝 แก้ไขข้อมูลเรียบร้อย</option>\n                    </select>\n                  </div>\n                  <div class=\"mb-2\">\n                    <label class=\"form-label small fw-bold text-navy\">หมายเหตุ (Remark ในกรณีที่ข้อมูล/เอกสารไม่ครบถ้วน)</label>\n                    <textarea id=\"modalPlayerRemarks\" class=\"form-control form-control-sm\" rows=\"3\" placeholder=\"ระบุสิ่งที่ต้องการให้นักกีฬาหรือผู้จัดการทีมแก้ไข เช่น รูปถ่ายไม่ชัดเจน, บัตรประชาชนหมดอายุ...\"></textarea>\n                  </div>\n                </div>\n              </div>\n\n            </div>\n          </div>\n        </div>\n        <div class=\"modal-footer bg-white rounded-bottom-4 py-2\">\n          <button type=\"button\" class=\"btn btn-sm btn-outline-secondary px-3\" data-bs-dismiss=\"modal\">ปิด</button>\n          <button type=\"button\" class=\"btn btn-sm btn-primary px-4 fw-semibold\" id=\"btnSaveAdminRemark\" onclick=\"saveAdminPlayerRemark()\">\n            <i class=\"bi bi-save me-1\"></i> บันทึกข้อมูล\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n",
    "after": "  ${renderPlayerVerificationModal()}\n\n"
  },
